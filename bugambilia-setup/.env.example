# Copia este archivo como .env y llena los valores. Nunca subas .env al repositorio.

# Neon (PostgreSQL)
# Conexión con pooler: la usa la app en tiempo de ejecución.
DATABASE_URL=
# Conexión directa (sin "-pooler" en el host): la usa la CLI de Prisma para migraciones.
DIRECT_URL=

# Better Auth
# Secreto aleatorio de 32+ caracteres (p. ej. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# URL del sitio: http://localhost:3000 en local; la de Netlify en producción
BETTER_AUTH_URL=

# Cuenta admin (solo la usa el seed; mínimo 8 caracteres de contraseña)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gemini (chatbot). Sin llave, el chatbot usa la plantilla de respaldo.
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-flash-latest)
GEMINI_MODELO=
